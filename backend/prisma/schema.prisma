datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HOUSING_MANAGER
  HOUSING_STAFF
  TECHNICAL_MANAGER
  TECHNICIAN
  HOUSEKEEPING
  WAREHOUSE_MANAGER
  HR_MANAGER
  SECURITY
  STAFF
}

enum EmployeeStatus {
  PENDING_ASSIGNMENT
  RESIDENT
  ON_LEAVE
  CHECKED_OUT
}

enum RoomStatus {
  READY
  NEEDS_CLEANING
  OUT_OF_ORDER
}

enum VisitorStatus {
  INSIDE
  EXITED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenanceType {
  GENERAL
  ROOM_INVENTORY
}

enum RoomInventoryStatus {
  HEALTHY
  MAINTENANCE_REQUIRED
  DAMAGED
  LOST
  IN_SERVICE
  REPLACEMENT_REQUIRED
  RETIRED
}

enum StockMovementType {
  OPENING
  RECEIPT
  ADJUSTMENT
  ROOM_ASSIGNMENT
  ROOM_RETURN
  ROOM_TRANSFER
  STATUS_CHANGE
  REPLACEMENT
  RETIREMENT
  PERSONNEL_ASSIGNMENT
  PERSONNEL_RETURN
}

model User {
  id                       String                  @id @default(uuid())
  username                 String                  @unique
  email                    String                  @unique
  passwordHash             String
  fullName                 String
  role                     Role                    @default(HOUSING_MANAGER)
  isActive                 Boolean                 @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  visitorsCreated          Visitor[]               @relation("VisitorCreatedBy")
  visitorsUpdated          Visitor[]               @relation("VisitorUpdatedBy")
  visitorsDeleted          Visitor[]               @relation("VisitorDeletedBy")
  employeesCreated         Employee[]              @relation("EmployeeCreatedBy")
  employeesCheckedOut      Employee[]              @relation("EmployeeCheckedOutBy")
  employeesDeleted         Employee[]              @relation("EmployeeDeletedBy")
  occupanciesCreated       OccupancyLog[]          @relation("OccupancyCreatedBy")
  occupanciesCheckedOut    OccupancyLog[]          @relation("OccupancyCheckedOutBy")
  inventoriesCreated       InventoryItem[]         @relation("InventoryCreatedBy")
  inventoriesReturned      InventoryItem[]         @relation("InventoryReturnedBy")
  disciplinaryNotesCreated DisciplinaryNote[]      @relation("DisciplinaryCreatedBy")
  notificationsCreated     Notification[]          @relation("NotificationCreatedBy")
  notificationsDeleted     Notification[]          @relation("NotificationDeletedBy")
  notificationRecipients   NotificationRecipient[]
  pushSubscriptions        PushSubscription[]
  stockMovements           StockMovement[]         @relation("StockMovementCreatedBy")
  employee                 Employee?               @relation("EmployeeUserAccount")
  sharedAssetLogs          SharedAssetLog[]        @relation("SharedAssetLogCreatedBy")
  userAuditActions         UserAuditLog[]           @relation("UserAuditActor")
  userAuditHistory         UserAuditLog[]           @relation("UserAuditTarget")
  supportTicketsCreated    SupportTicket[]         @relation("SupportTicketCreatedBy")
}

model UserAuditLog {
  id           String   @id @default(uuid())
  targetUserId String
  targetUser   User     @relation("UserAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUserId  String?
  actorUser    User?    @relation("UserAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  beforeRole   Role?
  afterRole    Role?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model Employee {
  id                    String         @id @default(uuid())
  tcNo                  String? // Sensitive TC/Passport
  tcNoHash              String?        @unique
  registrationNo        String?        @unique // Normalized Sicil No
  firstName             String // Normalized Ad
  lastName              String // Normalized Soyad
  gender                String // Required: Male / Female
  department            String // Required Dropdown
  title                 String? // Dropdown: Görev/Unvan
  company               String? // Normalized Taşeron/Şirket
  phone                 String? // Telefon
  isSmoker              Boolean        @default(false) // Sigara Kullanımı (Sigarasız/Sigaralı Oda)
  hasSnoring            Boolean        @default(false) // Horlama Durumu (Uyku Uyumluluğu)
  vehiclePlate          String? // Otopark araç plakası
  ageGroup              String? // Yaş Grubu (18-25, 26-40, 41-55, 56+)
  languageNationality   String? // Konuşulan Dil / Uyruk (Türkçe, İngilizce, Rusça, Arapça vb.)
  emergencyContactName  String? // Acil Durum Yakını Adı Soyadı
  emergencyRelation     String? // Acil Durum Yakınlık Derecesi (Dropdown)
  emergencyContactPhone String? // Acil Durum Yakını Telefonu
  photoUrl              String? // Photo (Base64/URL)
  shiftType             String?        @default("Gündüz") // Gündüz / Gece / Dönüşümlü
  status                EmployeeStatus @default(PENDING_ASSIGNMENT)
  isDeleted             Boolean        @default(false)
  deletedAt             DateTime?
  deletedById           String?
  deletedBy             User?          @relation("EmployeeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdById           String?
  createdBy             User?          @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  checkedOutById        String?
  checkedOutBy          User?          @relation("EmployeeCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  userId                String?        @unique
  user                  User?          @relation("EmployeeUserAccount", fields: [userId], references: [id], onDelete: SetNull)
  sharedAssets          SharedAsset[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  beds              Bed[]
  inventories       InventoryItem[]
  disciplinaryNotes DisciplinaryNote[]
  occupancies       OccupancyLog[]
  visitors          Visitor[]
  stockMovements    StockMovement[]
  supportTickets    SupportTicket[]

  @@index([status, isDeleted])
  @@index([department])
  @@index([lastName, firstName])
  @@index([createdById])
  @@index([checkedOutById])
  @@index([deletedById])
}

model Block {
  id           String   @id @default(uuid())
  name         String   @unique // e.g. A Blok, B Blok
  genderPolicy String // Male, Female, Mixed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rooms        Room[]
}

model Room {
  id         String     @id @default(uuid())
  blockId    String
  block      Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  floor      Int
  roomNumber String // e.g. 101, 102
  capacity   Int        @default(2)
  roomType   String?    @default("PERSONEL_ODASI")
  status     RoomStatus @default(READY)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  beds           Bed[]
  maintenances   MaintenanceLog[]
  inventories    RoomInventory[]
  cleaningLogs   RoomCleaningLog[]
  stockMovements StockMovement[]
  sharedAssets   SharedAsset[]

  @@unique([blockId, roomNumber])
}

model Bed {
  id                String    @id @default(uuid())
  roomId            String
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedLabel          String // e.g. Yatak-A, Yatak-B
  isOccupied        Boolean   @default(false)
  currentEmployeeId String?   @unique
  currentEmployee   Employee? @relation(fields: [currentEmployeeId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  occupancies OccupancyLog[]

  @@unique([roomId, bedLabel])
  @@index([currentEmployeeId])
}

model OccupancyLog {
  id                 String    @id @default(uuid())
  employeeId         String?
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName       String
  employeeDepartment String?
  employeeTitle      String?
  employeeCompany    String?
  bedId              String
  bed                Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  checkInDate        DateTime  @default(now())
  checkOutDate       DateTime?
  transferReason     String?
  createdById        String?
  createdBy          User?     @relation("OccupancyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  checkedOutById     String?
  checkedOutBy       User?     @relation("OccupancyCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  @@index([employeeId, checkInDate])
  @@index([bedId, checkOutDate])
  @@index([createdById])
  @@index([checkedOutById])
}

model InventoryItem {
  id           String     @id @default(uuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  itemName     String // Eşya / Cihaz Adı (Nevresim, Vestel TV vb.)
  itemCode     String? // Stok / Ürün Kodu (KEY-101 vb.)
  category     String     @default("LOJMAN_ZİMMETİ") // LOJMAN_ZİMMETİ veya ŞAHSİ_EŞYA
  status       String     @default("TESLİM_EDİLDİ") // TESLİM_EDİLDİ, TAM_İADE_ALINDI, ÇIKIŞ_İZİNLİ_ŞAHSİ_MÜLK
  serialNo     String? // Şahsi Eşya Seri Numarası / Markası
  photoUrl     String? // Şahsi Eşya / Cihaz Fotoğrafı (Opsiyonel)
  assignedDate DateTime   @default(now())
  returnedDate DateTime?
  notes        String? // Açıklama / Beyan notları
  createdById  String?
  createdBy    User?      @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  returnedById String?
  returnedBy   User?      @relation("InventoryReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  stockItemId  String?
  stockItem    StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([employeeId])
  @@index([createdById])
  @@index([returnedById])
  @@index([stockItemId])
}

model StockItem {
  id              String          @id @default(uuid())
  itemName        String          @unique
  itemCode        String?         @unique
  category        String          @default("GENEL")
  itemType        String          @default("DEMİRBAŞ") // DEMİRBAŞ veya SARF_MALZEME
  unit            String          @default("ADET")
  specifications  String? // Ölçü, renk, teknolojik detaylar (160x200 cm, 12000 BTU vb.)
  physicalStatus  String          @default("KULLANILABİLİR") // KULLANILABİLİR, KULLANIMDA, BAKIMDA, HURDA
  warrantyEndDate DateTime? // Garanti bitiş tarihi
  locationNote    String? // Bulunduğu konum / depo / blok / daire bilgisi
  minimumStock    Int             @default(5)
  isActive        Boolean         @default(true)
  lastCountedAt   DateTime?
  totalStock      Int             @default(0)
  usedStock       Int             @default(0)
  usedInRooms     Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inventories     InventoryItem[]
  roomInventories RoomInventory[]
  movements       StockMovement[]
}

model StockMovement {
  id                   String            @id @default(uuid())
  stockItemId          String
  stockItem            StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  type                 StockMovementType
  quantity             Int
  roomId               String?
  room                 Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomInventoryId      String?
  roomInventory        RoomInventory?    @relation(fields: [roomInventoryId], references: [id], onDelete: Restrict)
  personnelInventoryId String?
  employeeId           String?
  employee             Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  maintenanceId        String?
  maintenance          MaintenanceLog?   @relation(fields: [maintenanceId], references: [id], onDelete: Restrict)
  itemNameSnapshot     String
  roomLabelSnapshot    String?
  brand                String?
  serialNo             String?
  reason               String?
  notes                String?
  createdById          String?
  createdBy            User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())

  @@index([stockItemId, createdAt])
  @@index([roomId, createdAt])
  @@index([employeeId, createdAt])
  @@index([maintenanceId])
  @@index([type, createdAt])
}

model DisciplinaryNote {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String // Şikayet / Disiplin Başlığı
  content     String // Detaylı Açıklama
  reportedBy  String   @default("Lojman Amirliği") // Bildiren
  status      String   @default("GÖRÜŞÜLDÜ") // GÖRÜŞÜLDÜ, ÇÖZÜLDÜ, UYARILDI
  createdById String?
  createdBy   User?    @relation("DisciplinaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([createdById])
}

model MaintenanceLog {
  id                        String               @id @default(uuid())
  roomId                    String
  room                      Room                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  type                      MaintenanceType      @default(GENERAL)
  roomInventoryId           String?
  roomInventory             RoomInventory?       @relation(fields: [roomInventoryId], references: [id], onDelete: Restrict)
  inventoryStatus           RoomInventoryStatus?
  inventoryItemNameSnapshot String?
  inventoryBrandSnapshot    String?
  inventorySerialNoSnapshot String?
  inventoryAssetTagSnapshot String?
  inventoryQuantitySnapshot Int?
  category                  String?
  location                  String?
  title                     String
  description               String
  priority                  MaintenancePriority  @default(MEDIUM)
  status                    MaintenanceStatus    @default(OPEN)
  reportedBy                String
  assignedTo                String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  resolvedAt                DateTime?
  resolutionNote            String?
  serviceProvider           String?
  serviceReference          String?
  laborCost                 Float                  @default(0)
  partsCost                 Float                  @default(0)
  warrantyCovered           Boolean                @default(false)
  sentToServiceAt           DateTime?
  returnedFromServiceAt     DateTime?

  stockMovements StockMovement[]
  events         MaintenanceEvent[]

  @@index([roomId, status])
  @@index([roomInventoryId, status])
  @@index([type, createdAt])
  @@index([status, priority, createdAt])
}

model MaintenanceEvent {
  id                 String            @id @default(uuid())
  maintenanceId      String
  maintenance        MaintenanceLog    @relation(fields: [maintenanceId], references: [id], onDelete: Restrict)
  action             String
  fromStatus         MaintenanceStatus?
  toStatus           MaintenanceStatus?
  inventoryStatus    RoomInventoryStatus?
  notes              String?
  serviceProvider    String?
  serviceReference   String?
  laborCost          Float?
  partsCost          Float?
  warrantyCovered    Boolean?
  performedBy        String
  createdAt          DateTime          @default(now())

  @@index([maintenanceId, createdAt])
  @@index([action, createdAt])
}

model RoomInventory {
  id           String              @id @default(uuid())
  roomId       String
  room         Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  itemName     String
  location     String?             @default("")
  brand        String?
  serialNo     String?
  assetTag     String?             @unique
  quantity     Int                 @default(1)
  installedAt  DateTime            @default(now())
  status       RoomInventoryStatus @default(HEALTHY)
  notes        String?
  returnedAt   DateTime?
  stockItemId  String
  stockItem    StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  maintenances MaintenanceLog[]
  movements    StockMovement[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([roomId, status])
  @@index([stockItemId])
  @@index([serialNo])
}

model Visitor {
  id               String        @id @default(uuid())
  fullName         String
  visitorCount     Int           @default(1)
  phone            String?
  company          String?
  hostEmployeeId   String?
  hostEmployee     Employee?     @relation(fields: [hostEmployeeId], references: [id], onDelete: SetNull)
  hostEmployeeName String?
  hostRoomLabel    String?
  purpose          String?
  vehiclePlate     String?
  entryTime        DateTime      @default(now())
  exitTime         DateTime?
  status           VisitorStatus @default(INSIDE)
  notes            String?
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  createdById      String?
  createdBy        User?         @relation("VisitorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?         @relation("VisitorUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById      String?
  deletedBy        User?         @relation("VisitorDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([hostEmployeeId, entryTime])
  @@index([status, isDeleted, entryTime])
  @@index([fullName])
}

model RoomCleaningLog {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status      String    @default("NEEDS_CLEANING") // NEEDS_CLEANING, IN_PROGRESS, CLEANED
  requestedBy String    @default("Lojman Yönetimi")
  cleanedBy   String?
  notes       String?
  requestedAt DateTime  @default(now())
  cleanedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([roomId, status])
  @@index([roomId, requestedAt])
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationTargetType {
  ALL
  SPECIFIC_USERS
  BLOCK
  DEPARTMENT
  GENDER
}

model Notification {
  id          String                  @id @default(uuid())
  title       String
  message     String
  priority    NotificationPriority    @default(NORMAL)
  targetType  NotificationTargetType  @default(ALL)
  targetValue String?
  createdById String?
  createdBy   User?                   @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  isDeleted   Boolean                 @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?                   @relation("NotificationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())
  recipients  NotificationRecipient[]

  @@index([createdAt])
  @@index([createdById])
  @@index([isDeleted, createdAt])
  @@index([deletedById])
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum SharedAssetStatus {
  AVAILABLE
  LOANED
  MAINTENANCE
  RETIRED
}

model SharedAsset {
  id                 String            @id @default(uuid())
  assetCode          String            @unique
  assetName          String
  category           String            @default("GENEL")
  brandModel         String?
  serialNo           String?
  status             SharedAssetStatus @default(AVAILABLE)
  currentHolderType  String?           // 'EMPLOYEE' | 'ROOM' | 'OTHER'
  currentEmployeeId  String?
  currentEmployee    Employee?         @relation(fields: [currentEmployeeId], references: [id], onDelete: SetNull)
  currentRoomId      String?
  currentRoom        Room?             @relation(fields: [currentRoomId], references: [id], onDelete: SetNull)
  borrowedAt         DateTime?
  expectedReturnDate DateTime?
  warrantyEndDate    DateTime?
  locationNote       String?
  notes              String?
  logs               SharedAssetLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([category])
}

model SharedAssetLog {
  id                 String      @id @default(uuid())
  assetId            String
  asset              SharedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action             String      // 'CHECK_OUT' | 'CHECK_IN' | 'MAINTENANCE_START' | 'MAINTENANCE_END'
  borrowerName       String?
  employeeId         String?
  roomId             String?
  borrowedAt         DateTime    @default(now())
  returnedAt         DateTime?
  expectedReturnDate DateTime?
  notes              String?
  createdById        String?
  createdBy          User?       @relation("SharedAssetLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())

  @@index([assetId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model SupportTicket {
  id           String              @id @default(uuid())
  ticketNo     String              @unique
  employeeId   String?
  employee     Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  creatorName  String
  roomNumber   String?
  blockName    String?
  category     String              @default("GENEL")
  subject      String
  description  String
  status       SupportTicketStatus @default(OPEN)
  adminNote    String?
  resolvedAt   DateTime?
  createdById  String?
  createdBy    User?               @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([category])
  @@index([employeeId])
}
